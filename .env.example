# Copy to .env and fill in. Values already exported in your shell always win;
# .env.local (gitignored) is read first and overrides .env.
#
# Full reference: docs/configuration_zh.md

# ---------------------------------------------------------------------------
# Provider credentials (required)
# ---------------------------------------------------------------------------
# Execution and analysis credentials are independent. Never commit real keys.
HAI_EXECUTION_API_KEY=
HAI_EXECUTION_BASE_URL=https://your-execution-provider.example/v1
HAI_ANALYSIS_API_KEY=
# Task profiles explicitly choose model/base_url/api/api_key_env for both roles.
# See configs/experiments/crm-local.toml and docs/model-connections.zh-CN.md.
# The local profile uses David AI gpt-6.2-sol for analysis (Responses API).
# Direct CLI startup also accepts --models-config with these same model tables.
# HAI_DAB_ROOT=/path/to/dataagentbench
# HAI_INTELLIGENT_CONTEXT_LIMIT=200000
# Install the pinned Linux x64/ARM64 or macOS ARM64 runtime: python scripts/install_opencode.py
# HAI_OPENCODE_BIN=/path/to/harnesslens/runtime/opencode-1.18.32/bin/opencode
# HAI_CRM_RUNTIME_ROOT=/path/to/harnesslens/runtime/opencode-1.18.32
# HAI_OPENCODE_VERSION=1.18.32
# HAI_OPENCODE_LEGACY_CLI=0
# HAI_CRM_POSTGRES_PORT=55432
# Existing business solver; omitted means the native OpenCode solver.
# HAI_AGENT_CONFIG=/path/to/business-agent.toml
# Local API/Next.js server only, random >=24 characters; never NEXT_PUBLIC_*.
# HAI_SERVICE_TOKEN=
# HARNESSLENS_API_URL=http://127.0.0.1:8765
# Dedicated benchmark PostgreSQL admin connection, only for explicit init script.
# CRM_BENCHMARK_ADMIN_DSN=

# ---------------------------------------------------------------------------
# Paths (optional — defaults shown)
# ---------------------------------------------------------------------------
# Checkout root. Only needed when the package is installed outside the repo.
# HARNESSLENS_ROOT=/path/to/HarnessLens

# Agent runtimes. HAI_OPENCODE_BIN takes precedence; the checkout's pinned
# runtime is selected automatically before PATH. OPENCODE_PREFIX
# is a fallback when neither an explicit binary nor PATH provides OpenCode.
# OPENCODE_PREFIX=~/.opencode
# HAI_OPENCODE_BIN=~/.opencode/bin/opencode
# PI_AGENT_BIN=./.pi-agent/node_modules/.bin/pi
# HAI_CODEX_MODELS_CACHE=~/.codex/models_cache.json

# Terminal-Bench only: rootless docker state and the clash proxy controller.
# HAI_DOCKER_ROOT defaults to ~/dockers. If your rootless dockerd keeps its
# state on another volume, set this — otherwise the first rollout fails on an
# unreachable socket. `check_env.py --cell terminal-bench` resolves and reports
# the socket it will actually use.
# HAI_DOCKER_ROOT=~/dockers
# HAI_DOCKER_HOST=unix:///path/to/dockers/run/docker.sock
# TB_CLASHCTL_HOME=~/clashctl

# ---------------------------------------------------------------------------
# Budget and concurrency (optional — defaults shown)
# ---------------------------------------------------------------------------
# Total isolated intelligent sessions a single run may create.
# HAI_TOTAL_CREATION_BUDGET=200
# Repeats per TRAIN task; the reported experiments use 2.
# HAI_TRAIN_ROLLOUT_REPEATS=2
# HAI_MAX_ROLLOUT_CONCURRENCY=8
# HAI_MAX_ANALYSIS_CONCURRENCY=4
# HAI_PROVIDER_MAX_CONCURRENCY=16

# FDABench Lite report: assets/index are prepared on the Linux server.
# HAI_FDABENCH_ROOT=/data/fdabench-lite-report
# HAI_FDABENCH_INDEX=/data/fdabench-index/documents.sqlite
# HAI_FDABENCH_MAX_CONCURRENCY=8
# HAI_FDABENCH_TIMEOUT_S=900
# HAI_NATIVE_EXECUTION_ATTEMPTS=2
# Analysis is also the default host judge; optional all-four HAI_JUDGE_* override.
# HAI_ANALYSIS_BASE_URL=https://your-analysis-provider.example/v1
# HAI_JUDGE_MODEL=provider/model
# HAI_JUDGE_BASE_URL=https://your-judge-provider.example/v1
# HAI_JUDGE_API=responses
# HAI_JUDGE_API_KEY=
# Live FDABench web_search_prime MCP; solver never receives this credential.
# ZHIPU_API_KEY=
# HF_TOKEN=  # Existing authorized HF dataset access; download command only.
